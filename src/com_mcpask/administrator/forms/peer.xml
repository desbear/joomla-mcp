<?xml version="1.0" encoding="UTF-8"?>
<form>
	<field name="name" type="text" filter="string"
		label="COM_MCPASK_CONFIG_PEER_NAME" hint="COM_MCPASK_CONFIG_PEER_NAME_HINT" />
	<field name="url" type="url" filter="url" validate="url" required="true"
		label="COM_MCPASK_CONFIG_PEER_URL" hint="https://www.example.com" />
	<field name="key" type="password" filter="raw" autocomplete="off" maxlength="999"
		label="COM_MCPASK_CONFIG_PEER_KEY" />
	<field name="enabled" type="radio" layout="joomla.form.field.radio.switcher" default="1"
		label="JENABLED">
		<option value="0">JNO</option>
		<option value="1">JYES</option>
	</field>
</form>
