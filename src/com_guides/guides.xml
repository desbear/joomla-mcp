<?xml version="1.0" encoding="UTF-8"?>
<extension type="component" method="upgrade">
	<name>com_guides</name>
	<author>GSS</author>
	<creationDate>2026-10</creationDate>
	<copyright>(C) 2026 GSS</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE</license>
	<version>0.1.0</version>
	<description>COM_GUIDES_XML_DESCRIPTION</description>
	<namespace path="src">Gss\Component\Guides</namespace>

	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
			<file driver="postgresql" charset="utf8">sql/install.postgresql.utf8.sql</file>
		</sql>
	</install>
	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
			<file driver="postgresql" charset="utf8">sql/uninstall.postgresql.utf8.sql</file>
		</sql>
	</uninstall>

	<media destination="com_guides" folder="media">
		<folder>js</folder>
		<folder>css</folder>
	</media>

	<administration>
		<menu img="class:list-ol">COM_GUIDES</menu>
		<files folder="administrator">
			<filename>access.xml</filename>
			<filename>config.xml</filename>
			<folder>forms</folder>
			<folder>services</folder>
			<folder>sql</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
		</files>
		<languages folder="administrator/language">
			<language tag="en-GB">en-GB/com_guides.ini</language>
			<language tag="en-GB">en-GB/com_guides.sys.ini</language>
			<language tag="zh-TW">zh-TW/com_guides.ini</language>
			<language tag="zh-TW">zh-TW/com_guides.sys.ini</language>
		</languages>
	</administration>
</extension>
