<?xml version="1.0" encoding="UTF-8"?>
<config>
	<fieldset name="placement" label="COM_GUIDES_CONFIG_PLACEMENT" description="COM_GUIDES_CONFIG_PLACEMENT_DESC"
		addfieldprefix="Gss\Component\Guides\Administrator\Field">
		<field name="placement_mode" type="list" default="type_tags"
			label="COM_GUIDES_CONFIG_PLACEMENT_MODE" description="COM_GUIDES_CONFIG_PLACEMENT_MODE_DESC">
			<option value="type_tags">COM_GUIDES_CONFIG_PLACEMENT_TYPE_TAGS</option>
			<option value="topic">COM_GUIDES_CONFIG_PLACEMENT_TOPIC</option>
		</field>
		<field name="guide_category" type="category" extension="com_content" default="0" showon="placement_mode:type_tags"
			label="COM_GUIDES_CONFIG_GUIDE_CATEGORY" description="COM_GUIDES_CONFIG_GUIDE_CATEGORY_DESC">
			<option value="0">JSELECT</option>
		</field>
		<field name="target_type" type="list" default="content"
			label="COM_GUIDES_CONFIG_TARGET" description="COM_GUIDES_CONFIG_TARGET_DESC">
			<option value="content">COM_GUIDES_TARGET_CONTENT</option>
			<option value="flexicontent">COM_GUIDES_TARGET_FLEXICONTENT</option>
		</field>
		<field name="fc_type" type="guidesfctype" default="0" showon="target_type:flexicontent"
			label="COM_GUIDES_CONFIG_FC_TYPE" description="COM_GUIDES_CONFIG_FC_TYPE_DESC" />
		<field name="publish_state" type="radio" layout="joomla.form.field.radio.switcher" default="1"
			label="COM_GUIDES_CONFIG_PUBLISH_STATE" description="COM_GUIDES_CONFIG_PUBLISH_STATE_DESC">
			<option value="0">JUNPUBLISHED</option>
			<option value="1">JPUBLISHED</option>
		</field>
		<field name="publish_access" type="accesslevel" default="1"
			label="JFIELD_ACCESS_LABEL" description="COM_GUIDES_CONFIG_ACCESS_DESC" />
	</fieldset>
	<fieldset name="ai" label="COM_GUIDES_CONFIG_AI" description="COM_GUIDES_CONFIG_AI_DESC">
		<field name="ai_mode" type="list" default="mcpask"
			label="COM_GUIDES_CONFIG_AI_MODE" description="COM_GUIDES_CONFIG_AI_MODE_DESC">
			<option value="mcpask">COM_GUIDES_CONFIG_AI_MODE_MCPASK</option>
			<option value="own">COM_GUIDES_CONFIG_AI_MODE_OWN</option>
		</field>
		<field name="api_base" type="url" filter="url" default="https://api.openai.com/v1" showon="ai_mode:own"
			label="COM_GUIDES_CONFIG_API_BASE" />
		<field name="api_key" type="password" filter="raw" autocomplete="off" maxlength="999" showon="ai_mode:own"
			label="COM_GUIDES_CONFIG_API_KEY" />
		<field name="api_style" type="list" default="chat" showon="ai_mode:own"
			label="COM_GUIDES_CONFIG_API_STYLE">
			<option value="responses">Responses API</option>
			<option value="chat">Chat Completions API</option>
		</field>
		<field name="chat_model" type="text" filter="string" default="gpt-4.1-mini" showon="ai_mode:own"
			label="COM_GUIDES_CONFIG_CHAT_MODEL" />
	</fieldset>
	<fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL" description="JCONFIG_PERMISSIONS_DESC">
		<field name="rules" type="rules" label="JCONFIG_PERMISSIONS_LABEL" validate="rules" filter="rules"
			component="com_guides" section="component" />
	</fieldset>
</config>
