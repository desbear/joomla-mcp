<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="administrator" method="upgrade">
	<name>mod_guides_review</name>
	<author>GSS</author>
	<creationDate>2026-10</creationDate>
	<copyright>(C) 2026 GSS</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE</license>
	<version>0.1.0</version>
	<description>MOD_GUIDES_REVIEW_XML_DESCRIPTION</description>
	<namespace path="src">Gss\Module\GuidesReview</namespace>
	<files>
		<folder module="mod_guides_review">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<languages folder="language">
		<language tag="en-GB">en-GB/mod_guides_review.ini</language>
		<language tag="en-GB">en-GB/mod_guides_review.sys.ini</language>
		<language tag="zh-TW">zh-TW/mod_guides_review.ini</language>
		<language tag="zh-TW">zh-TW/mod_guides_review.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="count" type="number" label="MOD_GUIDES_REVIEW_FIELD_COUNT_LABEL"
					default="5" min="1" max="20" filter="integer" />
			</fieldset>
			<fieldset name="advanced">
				<field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" class="form-select" validate="moduleLayout" />
				<field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" rows="3" validate="CssIdentifier" />
			</fieldset>
		</fields>
	</config>
</extension>
