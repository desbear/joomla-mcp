<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="filter">
		<field name="search" type="text" inputmode="search" label="JSEARCH_FILTER" hint="JSEARCH_FILTER" />
		<field name="user_id" type="user" onchange="this.form.submit();" label="JGLOBAL_USERNAME" />
	</fields>
	<fields name="list">
		<field name="fullordering" type="list" onchange="this.form.submit();" default="t.created DESC" label="JGLOBAL_SORT_BY">
			<option value="t.created DESC">COM_MCP_SORT_NEWEST</option>
			<option value="t.created ASC">COM_MCP_SORT_OLDEST</option>
			<option value="t.last_used DESC">COM_MCP_CONNECTIONS_SORT_LAST_USED</option>
		</field>
		<field name="limit" type="limitbox" default="25" onchange="this.form.submit();" label="JGLOBAL_LIST_LIMIT" />
	</fields>
</form>
