<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="administrator" method="upgrade">
	<name>mod_mcp_ask_log</name>
	<author>GSS</author>
	<creationDate>2026-10</creationDate>
	<copyright>(C) 2026 GSS</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE</license>
	<version>0.13.2</version>
	<description>MOD_MCP_ASK_LOG_XML_DESCRIPTION</description>
	<namespace path="src">Gss\Module\McpAskLog</namespace>
	<files>
		<folder module="mod_mcp_ask_log">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<languages folder="language">
		<language tag="en-GB">en-GB/mod_mcp_ask_log.ini</language>
		<language tag="en-GB">en-GB/mod_mcp_ask_log.sys.ini</language>
		<language tag="zh-TW">zh-TW/mod_mcp_ask_log.ini</language>
		<language tag="zh-TW">zh-TW/mod_mcp_ask_log.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="count"
					type="number"
					label="MOD_MCP_ASK_LOG_FIELD_COUNT_LABEL"
					default="10"
					min="1"
					max="100"
					filter="integer"
				/>
			</fieldset>
			<fieldset name="advanced">
				<field
					name="layout"
					type="modulelayout"
					label="JFIELD_ALT_LAYOUT_LABEL"
					class="form-select"
					validate="moduleLayout"
				/>
				<field
					name="moduleclass_sfx"
					type="textarea"
					label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
					rows="3"
					validate="CssIdentifier"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
